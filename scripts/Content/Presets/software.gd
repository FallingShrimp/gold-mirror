class_name PresetSoftware

static func openssl(input: String, key: String, output: String):
	await TerminalManager.simulateCommand("openssl pkeyutl -decrypt -in %s -inkey %s -out %s" % [input, key, output])
	await TimeUtil.millseconds(500)
	await TerminalManager.progress(20)
	await TerminalManager.writeLine("\nDecryption successful. Output: %s" % output, 10, 2)
static func git(dir: String, msg: String, branch: String, remoteUrl: String):
	var oldHash = WorldManager.playerInstance.getCommitId()
	WorldManager.playerInstance.reinstance()
	var newHash = WorldManager.playerInstance.getCommitId()
	await TerminalManager.simulateCommand("git add %s" % dir)
	await TerminalManager.simulateCommand('git commit -m "%s"' % msg)
	await TerminalManager.writeLine("[master %s] %s" % [newHash, msg], 5)
	await TerminalManager.writeLine("%d files changed, %d insertions(+), %d deletions(-)" % [randi_range(1, 15), randi_range(100, 2000), randi_range(50, 200)], 5)
	await TerminalManager.simulateCommand("git push -u origin %s" % branch)
	var objCount = randi_range(100, 400)
	var compressedObjCount = ceil(objCount * 0.5)
	var deltaCount = ceil(compressedObjCount * 0.75)
	var localObjCount = ceil(deltaCount * 0.35)
	var size = randf_range(50, 500)
	var speed = randf_range(6, 16)
	await TerminalManager.writeLine("Enumerating objects: %d, done." % objCount, 5)
	await TerminalManager.writeLine("Counting objects: 100%% (%d/%d), done." % [objCount, objCount], 5)
	await TerminalManager.writeLine("Delta compression using up to %d threads" % MathUtil.randomChoiceFrom([64, 128, 256, 32768, 65536]), 5)
	await TerminalManager.writeLine("Compressing objects: 100%% (%d/%d), done." % [compressedObjCount, compressedObjCount], 5)
	await TerminalManager.writeLine("Writing objects: 100%% (%d/%d), %.2f KiB | %.2f MiB/s, done." % [compressedObjCount + 1, compressedObjCount + 1, size, speed], size / speed)
	await TerminalManager.writeLine("Total %d (delta %d), reused 0 (delta 0), pack-reused 0 (from 0)" % [compressedObjCount + 1, deltaCount], 5)
	await TerminalManager.writeLine("remote: Resolving deltas: 100%% (%d/%d), completed with %d local objects." % [deltaCount, deltaCount, localObjCount], 5)
	await TerminalManager.writeLine("To %s" % remoteUrl, 5)
	await TerminalManager.writeLine("%s..%s %s -> %s" % [oldHash, newHash, branch, branch], 5)
	await TerminalManager.writeLine("branch '%s' set up to track 'origin/%s'." % [branch, branch], 5)
